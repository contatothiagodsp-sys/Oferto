# Só o webhook do Telegram (com X-Telegram-Bot-Api-Secret-Token válido) passa pelo túnel. Todo o resto responde 403/404.
:80 {
	@telegram_ok {
		method POST
		path /webhook/telegram-ofertas
		header X-Telegram-Bot-Api-Secret-Token {$TELEGRAM_WEBHOOK_SECRET:__secret_nao_configurado__}
	}
	handle @telegram_ok {
		reverse_proxy n8n:5678
	}
	@telegram_sem_secret {
		method POST
		path /webhook/telegram-ofertas
	}
	handle @telegram_sem_secret {
		respond "Forbidden" 403
	}
	handle {
		respond "Not found" 404
	}
}
