# Modelo do arquivo .env do servidor local. Copie para "servidor-local/.env" e preencha só o que for usar.
#   PowerShell:  Copy-Item .env.example .env
# O .env está no .gitignore e NUNCA vai para o GitHub (o repositório é PÚBLICO).
# Aqui ficam só endereços e chaves de infraestrutura. Tokens de bot, chaves de afiliado, Keepa, Shopee
# e WhatsApp NÃO entram aqui: ficam só na Data Table bfx_config do n8n.
# Valor vazio = usa o padrão indicado no comentário.

# Importar e publicar os workflows de servidor-local/workflows no próximo "docker compose up".
# Padrão: vazio/nao (seguro: o n8n sobe com o que já está importado). Use "sim" só no deploy,
# depois de "npm run release". Volte para vazio/nao em seguida.
# Esta é a ÚNICA trava: os JSON de servidor-local/workflows são versionados e o "git pull" os altera.
# Depois de importar, rode "docker compose restart n8n" para o n8n ativar os gatilhos novos.
PUBLICAR_WORKFLOWS=

# URL de ping do healthchecks.io (ex.: https://hc-ping.com/<seu-uuid>). Vazio = sem ping externo.
HC_URL=

# Túnel usado pelo vigia: cloudflare (padrão, endereço muda) ou ngrok (endereço fixo).
TUNEL=

# Perfis extras do compose, separados por vírgula: render (gera a imagem dos posts) e/ou ngrok.
# Ex.: render,ngrok. Vazio = só os serviços padrão (sem render, as ofertas vão para revisão).
COMPOSE_PROFILES=

# Só com o ngrok: authtoken da sua conta ngrok (não é token de bot) e o domínio estático grátis
# (ex.: nome-aleatorio.ngrok-free.app).
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Proteção na borda (Caddy): deve bater com a chave "webhook_secret" da tabela bfx_config no n8n.
# Requisições POST /webhook/telegram-ofertas sem esse header X-Telegram-Bot-Api-Secret-Token recebem 403 no Caddy.
TELEGRAM_WEBHOOK_SECRET=
